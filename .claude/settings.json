{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase link*)",
      "Bash(psql*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Bash|Grep|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.js"
          }
        ]
      }
    ]
  }
}
